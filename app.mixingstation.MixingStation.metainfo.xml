  <releases>
    <release version="2.4.0" date="2025-07-20">
      <url type="details">https://mixingstation.app/changelogs/desktop/2_4_0</url>
      <description>
        <p>Added</p>
        <ul>
          <li>"Link" parameter for 76LA comp model</li>
          <li>A&amp;H Qu5/6/7: Support for new mixer models</li>
          <li>A&amp;H dLive: Support for firmware V2.11</li>
          <li>Midas HD: Access to multiband compressors</li>
          <li>Copy in MS scenes (T5651)</li>
        </ul>
        <p>Fixed</p>
        <ul>
          <li>A&amp;H SQ: Ducker threshold not working</li>
          <li>A&amp;H SQ: Global Tap Time not working</li>
          <li>A&amp;H SQ: Opt-Tronik and Bus Compressor may not work (T5686)</li>
          <li>Crash when using Waves FIT with mixer without channel colors</li>
          <li>TouchMix: TM30: Sync not working (T5716)</li>
          <li>Wing: Output routing can't be set to "None"</li>
          <li>Wing: Width not visible for bus channels</li>
          <li>Wing: main to matrix tap not working</li>
          <li>MIDI Spill Action works for DCA but not IDCA (T5685)</li>
          <li>Dyn8EQ Pinch gesture not working as expected (T5705)</li>
        </ul>
        <p>Changed</p>
        <ul>
          <li>Improved sends view</li>
          <li>Make IDCAs selectable</li>
        </ul>
      </description>
    </release>
  </releases>
